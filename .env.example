# WorkOS AuthKit — https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ characters. Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=
# Must be registered verbatim in the WorkOS dashboard for every origin.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Encrypts object-storage credentials before they are written to the database.
# Generate with: openssl rand -base64 32
# KEEP THIS STABLE. Changing or losing it makes every stored credential
# undecryptable, and they must be re-entered. Use the SAME value in production.
CREDENTIALS_ENCRYPTION_KEY=

# Supabase Postgres
# Dashboard > "Connect" button in the top bar (NOT Project Settings).
# Replace the literal [YOUR-PASSWORD] placeholder with the database password
# (Settings > Database > Reset database password if unknown), and URL-encode any
# special characters in it: @ -> %40, # -> %23, / -> %2F
#
# "Transaction pooler", port 6543. Used at runtime.
# Transaction mode cannot use prepared statements, which is why src/db/index.ts
# creates the postgres.js client with `prepare: false`.
DATABASE_URL=
# "Session pooler", port 5432. Used by drizzle-kit for migrations only.
# The modal also offers "Direct connection" (db.<ref>.supabase.co:5432), which is
# the textbook choice for DDL but is IPv6-only without the paid IPv4 add-on, so it
# fails on most home/office/CI networks. The session pooler is IPv4 on every tier
# and supports the prepared statements and DDL that migrations need.
DIRECT_URL=

# tldraw licence key — https://tldraw.dev
# Optional. Without it tldraw still works and only logs a warning about
# production use. NEXT_PUBLIC_ by necessity: tldraw validates the licence in the
# browser, so the key ships in the client bundle. It is a licence assertion
# rather than a credential, and is meant to be readable there.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Who may review and approve other users, comma-separated. Required: without it
# nobody is an admin, so no pending user could ever be approved and the site
# would be permanently closed to everyone new.
#
# Admin is derived from this list alone and never from a database column, so it
# cannot be granted by writing a row. An account listed here is force-approved on
# every sign-in, so you cannot lock yourself out of your own review screen.
ADMIN_EMAILS=you@example.com

# Google Analytics 4 measurement id, G-XXXXXXXXXX — https://analytics.google.com
# Optional. Leave empty and no analytics script, and no cookie banner, is served
# at all: the whole feature is absent rather than half-wired, which is what you
# want locally and in a fork. NEXT_PUBLIC_ by necessity — gtag runs in the
# browser and the id travels in every request it makes, so it cannot be secret.
#
# Adding this makes the site set cookies. It is loaded with Google's Consent
# Mode denied by default and asks before storing anything, and the privacy
# policy describes that behaviour — keep the two in step if you change it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search console ownership proofs. Both optional, both rendered as meta tags and
# therefore public by design. Google's is the content of the HTML-tag method in
# Search Console; Bing's is the content of its msvalidate.01 tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
